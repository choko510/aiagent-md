{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/device-client/contracts/device-pairing-v1.schema.json",
  "title": "Device pairing wire candidate v1",
  "description": "Development-only draft; no authorization of device actions.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "ATTACH"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "pairingId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "version",
        "kind",
        "tenantId",
        "ownerId",
        "pairingId",
        "token",
        "publicKey",
        "bindingDigest",
        "signature"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "CODE"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "publicKeySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "kind",
        "code",
        "publicKeySha256",
        "bindingDigest"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "CONSUME"
        }
      },
      "required": [
        "version",
        "kind"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "PAIRED"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "version",
        "kind",
        "identityId",
        "deviceId"
      ]
    }
  ]
}
