{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/device-client/contracts/device-connection-v1.schema.json",
  "title": "Device connection candidate v1",
  "description": "Draft only; connection authentication does not authorize device operations.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "HELLO"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "version",
        "kind",
        "tenantId",
        "ownerId",
        "identityId"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "PROOF"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "version",
        "kind",
        "signature"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "HEARTBEAT"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "version",
        "kind",
        "generation",
        "sequence"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "CHALLENGE"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "channelDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "issuedMs": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expiresMs": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "version",
        "kind",
        "nonce",
        "channelDigest",
        "generation",
        "issuedMs",
        "expiresMs"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "ACCEPTED"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expiresMs": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "version",
        "kind",
        "generation",
        "expiresMs"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "HEARTBEAT_ACK"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "version",
        "kind",
        "generation",
        "sequence"
      ]
    }
  ]
}
