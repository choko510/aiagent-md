{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/device-client/contracts/device-authority-v1.schema.json",
  "title": "Device authority candidate v1",
  "description": "Draft; signatures do not replace Gateway, Sentinel, online admission or durable consumption.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "CLOUD_GRANT",
        "START_PERMIT"
      ]
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "ownerUserId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "deviceIdentityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "toolIntentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "goalRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "leaseEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "restoreIncarnation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "deviceClaimEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "connectionGeneration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "attemptFence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "policyRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "revocationGeneration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "issuedAtMs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "expiresAtMs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "targetFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "argumentsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grantNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permitNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "serverOrigin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^https://"
    }
  },
  "required": [
    "version",
    "kind",
    "tenantId",
    "ownerUserId",
    "deviceIdentityId",
    "deviceId",
    "taskId",
    "runId",
    "toolIntentId",
    "operation",
    "goalRevision",
    "leaseEpoch",
    "restoreIncarnation",
    "deviceClaimEpoch",
    "connectionGeneration",
    "attemptFence",
    "policyRevision",
    "revocationGeneration",
    "issuedAtMs",
    "expiresAtMs",
    "targetFingerprint",
    "argumentsSha256",
    "grantNonce",
    "serverOrigin"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "START_PERMIT"
          }
        }
      },
      "then": {
        "required": [
          "permitNonce"
        ]
      },
      "else": {
        "not": {
          "required": [
            "permitNonce"
          ]
        }
      }
    }
  ]
}
