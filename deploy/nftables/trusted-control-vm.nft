#!/usr/sbin/nft -f
# Trusted Control VM: kernel default-deny egress. Containers are additionally confined by Docker `internal` networks
# (deploy/compose); only the `egress` bridge (Sentinel) may forward to the Internet. Loaded at boot (nftables.service).
flush ruleset

define EGRESS_BRIDGE = "br-aiagent-eg"     # docker network `egress` (com.docker.network.bridge.name)
define OPERATOR_HOST = 192.168.122.1       # KVM host (libvirt default network)

table inet aiagent {
  set os_update_mirrors { type ipv4_addr; flags interval; }   # filled by the operator (pinned package mirrors)

  chain output {
    type filter hook output priority 0; policy drop;
    oif "lo" accept
    ct state established,related accept
    meta skuid 0 tcp dport 443 ip daddr @os_update_mirrors accept
    ip daddr $OPERATOR_HOST tcp sport { 22, 8080 } accept
    counter log prefix "aiagent-out-drop " drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    iifname $EGRESS_BRIDGE oifname != "br-*" accept   # Sentinel container -> Internet (nothing else)
    counter log prefix "aiagent-fwd-drop " drop
  }

  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    ip saddr $OPERATOR_HOST tcp dport { 22, 8080 } accept   # operator SSH, API via host reverse proxy
  }
}
