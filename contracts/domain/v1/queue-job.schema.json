{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/queue-job.schema.json",
  "title": "RunJobPointerV1",
  "description": "Opaque queue payload: pointer + expected generation only. Not an authority; the consumer re-validates against the DB.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "kind": {
      "type": "string",
      "enum": [
        "run.start",
        "run.resume",
        "run.recover"
      ]
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "expectedGoalRevision": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "restoreIncarnation": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "scheduleOccurrenceId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/UtcInstant"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "tenantId",
    "taskId",
    "runId",
    "expectedGoalRevision",
    "restoreIncarnation",
    "scheduleOccurrenceId",
    "expiresAt"
  ]
}
