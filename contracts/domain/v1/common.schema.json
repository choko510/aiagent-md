{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/common.schema.json",
  "title": "Common definitions (CHAT_01 canonical, v1)",
  "description": "Shared scalar contracts. int64 values are canonical signed decimal strings on the wire (Architecture Rules E-3).",
  "$defs": {
    "Uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Server generated UUIDv7, canonical lowercase. Not an authorization capability."
    },
    "Int64": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-int64": true,
      "x-int64-min": "-9223372036854775808",
      "x-int64-max": "9223372036854775807"
    },
    "NonNegativeInt64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-int64": true,
      "x-int64-min": "0",
      "x-int64-max": "9223372036854775807"
    },
    "PositiveInt64": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "x-int64": true,
      "x-int64-min": "1",
      "x-int64-max": "9223372036854775807"
    },
    "UtcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SchemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "OpaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "ActorType": {
      "type": "string",
      "enum": ["user", "service"]
    },
    "ActorRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/ActorType"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "required": ["type", "id"]
    },
    "TaskState": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "WAITING_INPUT", "PAUSED", "WAITING_RECONCILIATION", "CANCELLING",
               "SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED", "EXPIRED", "BUDGET_EXHAUSTED"]
    },
    "RunState": {
      "type": "string",
      "enum": ["CREATED", "CLAIMED", "RUNNING", "WAITING_APPROVAL", "WAITING_INPUT", "PAUSED",
               "WAITING_RECONCILIATION", "CANCELLING", "SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED",
               "EXPIRED", "BUDGET_EXHAUSTED"]
    },
    "AggregateType": {
      "type": "string",
      "enum": ["task", "run", "watch", "approval", "tool", "evidence", "notification"]
    },
    "JsonObject": {
      "type": "object"
    }
  }
}
