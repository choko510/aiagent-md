{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/task-steer.schema.json",
  "title": "TaskSteerCommandV1",
  "description": "Steer: creates a new immutable goal revision; older revisions' approvals and intents become stale.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "expectedGoalRevision": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    }
  },
  "required": [
    "schemaVersion",
    "goal",
    "expectedGoalRevision"
  ]
}
