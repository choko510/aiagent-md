{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/approval-decision.schema.json",
  "title": "ApprovalDecisionCommandV1",
  "description": "The approver echoes the frozen request hash it was shown; a mismatch is rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    },
    "requestSha256": {
      "$ref": "common.schema.json#/$defs/Sha256Hex"
    },
    "expectedRecordVersion": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    }
  },
  "required": [
    "schemaVersion",
    "decision",
    "requestSha256",
    "expectedRecordVersion"
  ]
}
