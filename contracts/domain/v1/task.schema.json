{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/task.schema.json",
  "title": "TaskV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "ownerUserId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "workspaceId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "parentTaskId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryOfTaskId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "common.schema.json#/$defs/TaskState"
    },
    "goalRevision": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "activeRunId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordVersion": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/UtcInstant"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/UtcInstant"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "ownerUserId",
    "workspaceId",
    "parentTaskId",
    "retryOfTaskId",
    "state",
    "goalRevision",
    "activeRunId",
    "recordVersion",
    "createdAt",
    "updatedAt"
  ]
}
