{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/tenant-scope.schema.json",
  "title": "TenantScopeV1",
  "description": "Tenant (isolation boundary) != User (owner principal) != Workspace (physical scope). Resolved only from the authenticated context, never from client or queue payload.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "ownerUserId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "workspaceId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "ownerUserId",
    "workspaceId"
  ]
}
