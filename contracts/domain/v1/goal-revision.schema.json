{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/goal-revision.schema.json",
  "title": "GoalRevisionV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "goalSha256": {
      "$ref": "common.schema.json#/$defs/Sha256Hex"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/UtcInstant"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "taskId",
    "revision",
    "goalSha256",
    "createdAt"
  ]
}
