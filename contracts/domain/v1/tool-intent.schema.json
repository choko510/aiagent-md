{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/domain/v1/tool-intent.schema.json",
  "title": "ToolIntentV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "toolKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "invocationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestSha256": {
      "$ref": "common.schema.json#/$defs/Sha256Hex"
    },
    "riskClass": {
      "type": "string",
      "enum": [
        "read",
        "write_reversible",
        "external_irreversible"
      ]
    },
    "goalRevision": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    },
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "PENDING_APPROVAL",
        "SENDING",
        "CONFIRMED",
        "DENIED",
        "EXPIRED",
        "STALE_GOAL",
        "REVOKED",
        "CANCELLED",
        "UNKNOWN",
        "BUDGET_EXHAUSTED",
        "FAILED"
      ]
    },
    "recordVersion": {
      "$ref": "common.schema.json#/$defs/PositiveInt64"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "taskId",
    "runId",
    "toolKey",
    "invocationKey",
    "requestSha256",
    "riskClass",
    "goalRevision",
    "status",
    "recordVersion"
  ]
}
