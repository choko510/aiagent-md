{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choko510/aiagent-md/contracts/muse/external-action-proposal.schema.json",
  "title": "ExternalActionProposalV1 (untrusted child RPC, not a grant)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": [
        "http.read",
        "connector.invoke",
        "browser.action",
        "notify.send",
        "package.fetch"
      ]
    },
    "args": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "description": "Broker validates args against pinned registered Tool schema; envelope shape alone never authorizes."
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "operation",
    "args",
    "requestId"
  ],
  "description": "Untrusted envelope only; no permission. Broker MUST apply registered operation-specific schema, authentication, policy, quota and Sentinel/Transport enforcement.",
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "http.read"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 9,
                "maxLength": 8192,
                "pattern": "^https://"
              },
              "method": {
                "enum": [
                  "GET",
                  "HEAD"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
